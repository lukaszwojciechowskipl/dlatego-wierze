---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CONSTELLATIONS } from '@/lib/constants';
---

<BaseLayout>
  <!-- HERO: placeholder for the R3F galaxy that ships in Phase 3 -->
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 opacity-60">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,oklch(0.32_0.08_265/0.55),transparent_60%)]"></div>
      <!-- Decorative star field built from CSS box-shadows -->
      <div class="absolute inset-0 stars-bg"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary/80 mb-6">
        15 konstelacji · jedna prawda
      </p>
      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl xl:text-8xl leading-[1.05] mb-6">
        Dlatego <span class="text-primary">Wierzę</span>
      </h1>
      <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        Galaktyka piętnastu niezależnych linii argumentacji za prawdziwością chrześcijaństwa.
        Filozofia, nauka, historia, świadectwa, cuda — w&nbsp;jednym miejscu.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/argumenty/filozofia"
          class="inline-flex items-center gap-2 rounded-full bg-primary text-primary-foreground px-6 py-3 text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Wejdź w&nbsp;galaktykę
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="/o-projekcie"
          class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-medium hover:bg-secondary/40 transition-colors"
        >
          O&nbsp;projekcie
        </a>
      </div>
    </div>

    <p class="absolute bottom-6 left-1/2 -translate-x-1/2 text-xs uppercase tracking-widest text-muted-foreground/60 animate-pulse">
      Przewiń ↓
    </p>
  </section>

  <!-- BENTO MAP — 15 constellations as cards -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="mb-10 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary/80 mb-3">15 konstelacji</p>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl mb-4">Mapa rozumnych powodów</h2>
      <p class="text-muted-foreground leading-relaxed">
        Każda konstelacja to osobna, samowystarczalna linia argumentacji. Możesz wejść w&nbsp;dowolną
        — żadna nie zależy od pozostałych, ale razem tworzą galaktykę spójnych dowodów.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {CONSTELLATIONS.map((c) => (
        <li>
          <a
            href={`/argumenty/${c.slug}`}
            class="group block h-full rounded-xl border border-border/60 bg-card/40 backdrop-blur-sm p-5 hover:border-primary/40 hover:bg-card/70 transition-all relative overflow-hidden"
            style={`--accent: hsl(${c.hue} 70% 65%)`}
          >
            <div
              aria-hidden="true"
              class="absolute -top-12 -right-12 w-32 h-32 rounded-full blur-3xl opacity-30 group-hover:opacity-60 transition-opacity"
              style="background: var(--accent)"
            ></div>
            <div class="relative">
              <p class="font-mono text-[10px] uppercase tracking-widest opacity-50 mb-2">
                Konstelacja {String(c.id).padStart(2, '0')} · {c.category}
              </p>
              <h3 class="font-serif text-lg leading-tight mb-2" style="color: var(--accent)">
                {c.shortName}
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3">
                {c.teaser}
              </p>
              <p class="mt-4 text-xs text-foreground/60 inline-flex items-center gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                Czytaj
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- TEASER: highlights section ships fully in Phase 3 with Sanity data -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20">
    <div class="rounded-2xl border border-border/40 bg-gradient-to-br from-card/60 to-card/20 p-8 lg:p-12 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary/80 mb-3">Najnowsze świadectwa</p>
      <h2 class="font-serif text-2xl sm:text-3xl mb-3">Najnowsze opowieści wiary</h2>
      <p class="text-muted-foreground max-w-xl mx-auto mb-6">
        Wkrótce: kafelki świadectw i&nbsp;cudów dodawanych przez redakcję w&nbsp;panelu Sanity.
      </p>
      <a
        href="/swiadectwa"
        class="inline-flex items-center gap-2 text-primary hover:opacity-80 text-sm"
      >
        Przejdź do&nbsp;galerii świadectw
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Decorative starfield via box-shadow — cheap, no JS */
  .stars-bg {
    background-image:
      radial-gradient(1px 1px at 25% 30%, white, transparent),
      radial-gradient(1px 1px at 75% 60%, white, transparent),
      radial-gradient(1.5px 1.5px at 50% 80%, white, transparent),
      radial-gradient(1px 1px at 15% 70%, white, transparent),
      radial-gradient(1.5px 1.5px at 90% 25%, white, transparent),
      radial-gradient(1px 1px at 60% 15%, oklch(0.85 0.16 85), transparent),
      radial-gradient(1px 1px at 35% 50%, white, transparent),
      radial-gradient(1.5px 1.5px at 80% 85%, oklch(0.85 0.16 85), transparent);
    background-size: 100% 100%;
    opacity: 0.7;
  }
</style>
