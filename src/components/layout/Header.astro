---
import Nav from './Nav.astro';
---

<header class="sticky top-0 z-40 border-b border-border/50 bg-background/70 backdrop-blur-md supports-[backdrop-filter]:bg-background/50">
  <div class="mx-auto max-w-7xl flex items-center justify-between gap-6 px-4 sm:px-6 lg:px-8 h-14 relative">
    <a href="/" class="flex items-center gap-2.5 group">
      <span aria-hidden="true" class="relative inline-flex w-7 h-7 items-center justify-center">
        <span class="absolute inset-0 rounded-full bg-primary/20 blur-md group-hover:bg-primary/40 transition-colors"></span>
        <svg viewBox="0 0 24 24" width="22" height="22" class="relative">
          <circle cx="12" cy="12" r="2" fill="var(--color-cosmos-gold)" />
          <circle cx="5"  cy="6"  r="0.7" fill="var(--color-parchment)" opacity="0.8" />
          <circle cx="19" cy="6"  r="0.7" fill="var(--color-parchment)" opacity="0.6" />
          <circle cx="20" cy="16" r="0.6" fill="var(--color-parchment)" opacity="0.7" />
          <circle cx="4"  cy="17" r="0.6" fill="var(--color-parchment)" opacity="0.6" />
          <circle cx="11" cy="3"  r="0.5" fill="var(--color-parchment)" opacity="0.5" />
          <line x1="12" y1="12" x2="5"  y2="6"  stroke="var(--color-cosmos-gold)" stroke-width="0.4" opacity="0.5"/>
          <line x1="12" y1="12" x2="19" y2="6"  stroke="var(--color-cosmos-gold)" stroke-width="0.4" opacity="0.4"/>
          <line x1="12" y1="12" x2="20" y2="16" stroke="var(--color-cosmos-gold)" stroke-width="0.4" opacity="0.4"/>
          <line x1="12" y1="12" x2="4"  y2="17" stroke="var(--color-cosmos-gold)" stroke-width="0.4" opacity="0.3"/>
        </svg>
      </span>
      <span class="font-serif text-base sm:text-lg leading-none">
        <span class="text-foreground">Dlatego</span>&nbsp;<span class="text-primary">Wierzę</span>
      </span>
    </a>

    <Nav />
  </div>
</header>
