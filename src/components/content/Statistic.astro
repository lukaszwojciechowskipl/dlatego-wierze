---
interface Props {
  value: string;
  label: string;
  source?: string;
}

const { value, label, source } = Astro.props;
---

<div class="my-8 rounded-xl border border-border/40 bg-card/30 p-6 text-center">
  <p class="font-serif text-5xl sm:text-6xl text-primary leading-none tracking-tight">
    {value}
  </p>
  <p class="mt-3 text-sm text-foreground/85 [text-wrap:balance]">{label}</p>
  {source && <p class="mt-2 text-xs text-muted-foreground/70">źródło: {source}</p>}
</div>
